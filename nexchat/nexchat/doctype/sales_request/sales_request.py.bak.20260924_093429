import frappe
from frappe import _
from frappe.model.document import Document


ALLOWED_ROLE = "Voice Agent API"


class SalesRequest(Document):
    ALLOWED_STATUS_TRANSITIONS = {
        "New": {
            "In Progress",
            "Waiting on Rep",
            "Quote Ready",
            "Cancelled",
        },
        "In Progress": {
            "Waiting on Rep",
            "Quote Ready",
            "Cancelled",
        },
        "Waiting on Rep": {
            "In Progress",
            "Quote Ready",
            "Cancelled",
        },
        "Quote Ready": {
            "Completed",
            "Cancelled",
        },
        "Completed": set(),
        "Cancelled": set(),
    }

    def validate(self):
        if self.rep_code:
            self.rep_code = self.rep_code.strip().upper()

        self._validate_priority()
        self._validate_assignment()
        self._validate_status_transition()

        if self.status == "Completed" and not self.completed_at:
            self.completed_at = frappe.utils.now_datetime()

        if self.status != "Completed" and self.completed_at:
            self.completed_at = None

    def _validate_priority(self):
        allowed = {
            "Low",
            "Normal",
            "High",
            "Urgent",
        }

        if not self.priority:
            self.priority = "Normal"

        if self.priority not in allowed:
            frappe.throw(
                _("Invalid Sales Request priority."),
                frappe.ValidationError,
            )

    def _validate_assignment(self):
        if not self.assigned_to:
            return

        enabled = frappe.db.get_value(
            "User",
            self.assigned_to,
            "enabled",
        )

        if enabled != 1:
            frappe.throw(
                _("Assigned user must be an enabled ERPNext user."),
                frappe.ValidationError,
            )

    def _validate_status_transition(self):
        if self.is_new():
            return

        old_doc = self.get_doc_before_save()

        if not old_doc:
            return

        old_status = old_doc.status
        new_status = self.status

        if not old_status or old_status == new_status:
            return

        allowed = self.ALLOWED_STATUS_TRANSITIONS.get(
            old_status,
            set(),
        )

        if new_status not in allowed:
            frappe.throw(
                _(
                    "Invalid Sales Request status transition: "
                    "{0} → {1}."
                ).format(
                    frappe.bold(old_status),
                    frappe.bold(new_status),
                ),
                frappe.ValidationError,
            )


def _require_voice_agent_role():
    roles = frappe.get_roles(frappe.session.user)

    if ALLOWED_ROLE not in roles and "System Manager" not in roles:
        frappe.throw(
            _("Not permitted to create Sales Requests."),
            frappe.PermissionError,
        )


@frappe.whitelist()
def create_sales_request(
    rep_code=None,
    source="AI Voice",
    request_text=None,
):
    _require_voice_agent_role()

    rep_code = (rep_code or "").strip().upper()

    if not rep_code:
        frappe.throw(
            _("Rep Code is required."),
            frappe.ValidationError,
        )

    rep = frappe.db.get_value(
        "AI Sales Rep",
        {
            "rep_code": rep_code,
            "active": 1,
        },
        [
            "rep_name",
            "sales_person",
        ],
        as_dict=True,
    )

    if not rep:
        frappe.throw(
            _("No active AI Sales Rep found for Rep Code {0}.").format(
                frappe.bold(rep_code)
            ),
            frappe.ValidationError,
        )

    doc = frappe.get_doc({
        "doctype": "Sales Request",
        "source": source or "AI Voice",
        "rep_code": rep_code,
        "request_text": request_text,
        "status": "New",
    })

    doc.insert()

    return {
        "name": doc.name,
        "status": doc.status,
        "source": doc.source,
        "rep_code": doc.rep_code,
        "rep_name": doc.rep_name,
        "sales_person": doc.sales_person,
        "customer": doc.customer,
        "quotation": doc.quotation,
    }


@frappe.whitelist()
def link_draft_quotation(
    sales_request=None,
    quotation=None,
):
    _require_voice_agent_role()

    if not sales_request:
        frappe.throw(
            _("Sales Request is required."),
            frappe.ValidationError,
        )

    if not quotation:
        frappe.throw(
            _("Quotation is required."),
            frappe.ValidationError,
        )

    if not frappe.db.exists(
        "Sales Request",
        sales_request,
    ):
        frappe.throw(
            _("Sales Request {0} does not exist.").format(
                frappe.bold(sales_request)
            ),
            frappe.ValidationError,
        )

    if not frappe.db.exists(
        "Quotation",
        quotation,
    ):
        frappe.throw(
            _("Quotation {0} does not exist.").format(
                frappe.bold(quotation)
            ),
            frappe.ValidationError,
        )

    doc = frappe.get_doc(
        "Sales Request",
        sales_request,
    )

    if doc.quotation and doc.quotation != quotation:
        frappe.throw(
            _(
                "Sales Request {0} is already linked to "
                "Quotation {1}. Refusing to replace it."
            ).format(
                frappe.bold(sales_request),
                frappe.bold(doc.quotation),
            ),
            frappe.ValidationError,
        )

    quotation_docstatus = frappe.db.get_value(
        "Quotation",
        quotation,
        "docstatus",
    )

    if quotation_docstatus != 0:
        frappe.throw(
            _(
                "Safety stop: only Draft Quotations "
                "can be linked to AI Sales Requests."
            ),
            frappe.ValidationError,
        )

    quotation_customer = frappe.db.get_value(
        "Quotation",
        quotation,
        "party_name",
    )

    quotation_sales_people = frappe.get_all(
        "Sales Team",
        filters={
            "parenttype": "Quotation",
            "parent": quotation,
        },
        pluck="sales_person",
    )

    if not quotation_sales_people:
        frappe.throw(
            _(
                "Quotation {0} has no Sales Person assigned."
            ).format(
                frappe.bold(quotation)
            ),
            frappe.ValidationError,
        )

    if doc.sales_person not in quotation_sales_people:
        frappe.throw(
            _(
                "Sales Person mismatch. "
                "Sales Request belongs to {0}, "
                "but Quotation {1} belongs to {2}."
            ).format(
                frappe.bold(doc.sales_person),
                frappe.bold(quotation),
                frappe.bold(
                    ", ".join(quotation_sales_people)
                ),
            ),
            frappe.ValidationError,
        )

    doc.quotation = quotation
    doc.customer = quotation_customer
    doc.status = "Quote Ready"

    if not doc.quote_ready_at:
        doc.quote_ready_at = frappe.utils.now_datetime()

    doc.save()

    return {
        "name": doc.name,
        "status": doc.status,
        "customer": doc.customer,
        "quotation": doc.quotation,
        "quotation_docstatus": quotation_docstatus,
        "sales_person": doc.sales_person,
    }

